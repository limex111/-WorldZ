# Вы можете расположить сценарий своей игры в этом файле.

# Определение персонажей игры.
define v = Character('Вера', color="#8400ff", image="vera")
define a = Character('Артем', color="#67c967", image="artem")
define nez = Character('Неизвестно', color="#3700fd")
define vl = Character('Влад', color="#3700fd")
define pr = Character('    ', color="#646d64")
define kas = Character('Библиотекарь', color="#000000")
define m = Character('Маша', color="#8400ff")
define nez2 = Character('Неизвестно', color="#ff0000")
define nez3 = Character('Неизвестно', color="#00eeff")
define n = Character(None, kind=nvl)

# Решения на понижение отнощения
define error = 0
# Вместо использования оператора image можете просто
# складывать все ваши файлы изображений в папку images.
# Например, сцену bg room можно вызвать файлом "bg room.png",
# а eileen happy — "eileen happy.webp", и тогда они появятся в игре.

define audio.mus1 = "music/mus1.mp3"
define audio.mus2 = "music/mus2.mp3"
define audio.park = "music/park.mp3"
define audio.ru = "sound/ruchka.mp3"
define audio.most = "music/most.mp3"
define audio.bib = "music/bib.mp3"
define audio.feer = "sound/feer.mp3"
#Баги


    

image zzz:
    "vera normal"
    pause 0.1
    "vlad1"
    pause 0.1
    "vera normal"
    pause 0.1
    "artem normal"
    pause 0.1
    "bb"
    pause 0.1
    repeat

image priz:
    alpha 0.5
    "prizrak"
    pause 50

image zxc:
    "vlad1"
    pause 0.1
    "vera normal"
    pause 0.1
    repeat

image bg aaa:
    
    "bg pom1"
    pause 0.1       
   
    "bg pom3"
    pause 0.1

    "bg pom2"
    pause 0.1
    repeat

image ccc:
    "o1"
    pause 0.1   
    "o3"
    pause 0.1   
    "o2"
    pause 0.1   
    repeat
init :
    $ left2 = Position(xalign=0.2)
    $ right2 = Position(xalign=0.8)
    

# Игра начинается здесь:
label start:
    window hide
    n ''' 
    История повествует о самом обычном мальчишке.
    
    Попробуй проявить чувства у Артема.

    Получится ли у тебя?
    '''
    nvl hide 

    jump nachalo
    return

label nachalo:
    play music mus2
    scene bg small town
    with fade
    show artem normal at left2
    with dissolve

    a "Фух, вот я и выбрался с пар в парк."

    a "Этот парк всегда наполняет меня особенной энергией. Зеленые аллеи, пение птиц, теплые лучи солнца – все это создает идеальное место для отдыха и вдохновения."
    
    a @ happy  "Сегодняшний день особенно солнечный, и в воздухе чувствуется свежесть. Чувствую, день пройдет отлично!"

    show artem normal at left2
    with dissolve
    a "Не думал, что встречу ее здесь."

    "Артем увидел перед собой Веру. Великолепную художницу."
    
    a "Она также хорошо выглядит, как и всегда. Ее мастерство писать картины поражает меня каждый раз. Ее картины словно окно в другой мир, полный красок и чудес."
   
    a "Нужно ли мне подойти к ней? Не помешаю ли я ей писать картину?"

    menu :
        "Что же сделать?"
      
        "Решить подойти.":
            jump podosel
      
        "Решить не подходить.":
            jump ne_podosel
        
            
    
    return

label ne_podosel:
    show artem normal at left2
    $ error += 1
    play sound ru
    a @ blush "Наверное, лучше остаться на месте. Вера так увлечена своими делами, быть может, она предпочтет оставаться в своем творческом мире одна. Возможно смогу поговорить с ней позже."

    a @ blush "В конце концов, нужно уважать личное пространство других."
    
    nez "Эй."

    "Кто-то откликнул Артема за спиной."
   
    "Артем обернулся и увидел там своего друга с параллельной группы."
    
    a @ happy "А, Влад, это ты, привет!"
    
    show vlad1 at right2
    with dissolve
    vl "Привет Артем! Как дела?"
    
    a "Да все прекрасно."
    
    vl "Что делаешь здесь?"

    a "Этот университетский парк предоставляет мне уединенное место, где я могу насладиться спокойствием и размышлениями. Вот и решил здесь прогуляться. А ты?"

    vl "А я проект дома забыл, и мне как раз по этому пути домой."

    a "Точно, мне ведь сегодня книгу сдавать нужно. А то еще штраф дадут, за то, что книгу не вернул."
    hide vlad1

    show zxc at right2

    vl "Видимо мы оба торопимся, ну я побежал. Еще увидимся."
    hide zxc
    a "Что?"
     
    a "Наверное показалось, ладно, мне тоже нужно идти уже."

    a "Нужно успеть сдать книгу."

    hide artem normal
    jump library_ne_podosel
    return

label podosel:
    play sound ru
    show bg school
    with fade
    show artem normal at left2
    with dissolve
    a "А что если она обрадуется нашей встречи? Ведь мы не виделись уже несколько недель."
    "Решение принимается мгновенно. Артем подошел к Вере."
    show vera normal at right2
    with dissolve
    "Вера повернулась к Артему"
    v "Ой! Артем, привет! Давно не виделись, как твои дела?"
   
    a "Мои дела отличны, у тебя как?"
  
    v @ smile "Не дождешься!"

    a @ happy "Ха-ха-ха!"

    v "Что делаешь тут?"

    a "Да так, прогуляться решил в парке, думал тебя смогу здесь увидеть."

    v "Ну я не выходила так как очень уставала на занятиях. У нас экзамен был по живописи."

    a normal "Ну и как, сдала?"

    v @ smile "Да, сдала на отлично!"

    v "А у тебя как с биологией?"
    show vera normal at right2

    v "Насчет твоей учебы."

    a "Да, пока сидим изучаем высшие растения."

    a "Это конечно интересно, но еще интереснее, что у тебя с проектом? Не поделишься своим творческим процессом?"

    v "Конечно, рада буду поделиться. Проект еще не доделала, как и сказала, была занята экзаменами. Вот сейчас продолжила писать картину."

    a "Поскорее бы увидеть ее готовой."

    v "Когда напишу - покажу тебе первым!"

    v "А сейчас пока восстанавливаюсь. Так сказать. Ищу вдохновения!"

    a "Слушай, мне сейчас книгу нужно сдать в библиотеку. Не хочешь со мной сходить? Может быть найдем там для вдохновения чего-нибудь."
    
    v "Почему бы и нет, сейчас соберу вещи. Здесь в парке же их не оставишь, верно?"

    a @ happy "Верно, давай помогу тебе."

    v @ smile "Спасибо!"

    "Артем помог вере собрать вещи и они направилсь в студенческую библиотеку."
    jump library_podosel
    return

label library_podosel:
    stop music fadeout 0.5
    play music bib
    show bg library
    with fade
    
    "Артем вместе с Верой зашли в библиотеку."
    show artem normal at left2
    with dissolve
    show vera normal at right2
    with dissolve
    a "Да, точно. У меня тут книга, которую нужно вернуть. Подожди меня здесь, я быстро сделаю это."

    v "Хорошо."

    "Артем сдал книгу и вернулся к Вере, которая решила подсмотреть себе чего-нибудь почитать."

    v "Библиотека всегда была для меня местом, где можно найти вдохновение и уют. Все эти старые книги, запах бумаги – словно магия. И, конечно, здесь можно найти много интересного для своего творчества."

    a "Библиотека действительно магическое место. Мне нравится ее тишина и покой."

    a "Ты часто бываешь тут?"

    v "Бывает иногда могу зайти. Обычно я просто блуждаю по полкам, читаю отрывки из разных книг. Иногда находится что-то, что меня вдохновляет."

    v "Кстати, а ты когда закончишь свой проект?"

    a "О, да. У меня еще идет работа по нему,я искал материалы, которые могли бы мне помочь. Может быть, здесь есть что-то интересное."
   
    v "Знаешь, Артем, мне всегда казалось, что наука и искусство могут взаимно дополнять друг друга. Возможно, мы найдем какие-то удивительные сочетания в наших проектах." 

    a "Да, возможно. Никогда не знаешь, где найдется вдохновение"

    v "Слушай, а у тебя есть какие-либо дела на завтра?"

    a "Да вроде как нету, а что?"

    v 'Можем завтра пойти в галлерею "Мраморин". Ты не против?'

    a "Ух-ты, конечно не против! Во сколько пойдем?"

    v "Отлично! Я сегодня напишу тебе время. До встречи!"

    a "Хорошо, увидимся!"
    hide vera normal
    with dissolve
    a "Вера пошла взяла какую-то книгу с полки и пошла с ней на кассу. Видимо это что-то для ее картины."

    a "Мне тоже пора идти, нужно положить книгу обратно и домой пойти."

    hide artem normal
    with dissolve
    show priz at right2
    with dissolve
    pr "Объект, проснитесь."
    jump room
    return

label library_ne_podosel:
    hide priz 
    stop music fadeout 0.5
    play music bib
    show bg library
    with fade
    show artem normal at left2  
    with dissolve
    "Артем прибегает в студенческую библиотеку, где царит тишина, нарушаемая лишь шепотом и шелестом страниц. Он торопливо идет сдавать книгу по биологии."

    a "Надеюсь, что я не опоздал."

    a "Здравствуйте, могу я сдать книгу?"

    show bb at right2
    with dissolve
    kas "Здравствуйте, да, сейчас."

    kas "Все хорошо, можете подыскать себе еще что-либо почитать."
    hide bb
    with dissolve
    a "Фух. Это был неплохой урок о том, что нужно следить за временем."
  
    a "Пока время есть, можно сесть и почитать что-либо."

    a "Гхм, может сейчас прочитать про художество?"

    a "Так, что тут у нас есть?"

    a 'О, можно взять эту, "Вдох и искусство".'

    "Прошло 30 минут"

    a "Ну, кажется довольно интересным. Пора собираться."

    nez "Ай."

    a "Что там происходит?"

    "Артем подглянул за полку книг."

    "За полкой стояла Вера, она пыталась достать какую-то книгу. Может подойти помочь ей?"

    menu:
        "Нужна ли ей моя помощь?"
        "Подойти помочь.":
            jump library_pomog
        "Уйти.":
            jump library_ne_pomog
    return

label library_pomog:
    play sound ru
    show bg library polki
    with fade

    show artem normal at left2
    with dissolve
    a "Привет. Не эту ли книгу пытаешься достать?"

    "Артем берет книгу до которой тянулась Вера."

    show vera wink at right2
    with dissolve
    v "Ой! Напугал!"

    v normal "Привет, да эту книгу хотела."

    v @ wink "Спасибо!"

    a @ blush "Прости, я не хотел тебя пугать, что читаешь тут?"

    v @ smile "Ничего страшного, меня это даже развеселило."

    v "Я готовлюсь к новому проекту, и хочу подсмотреть что-то интересное."

    a "Это звучит отлично. А насчет предыдущего проекта? Уже доделала?"

    v "Еще нет, но почти закончила. Как закончу, тебе первому покажу!"

    a @ blush "Ой, спасибо за такую честь"

    v "А что ты тут читаешь?"

    a "Да меня художество заинтересовало немного. Вот и решил почитать."

    v "Слушай, а у тебя есть какие-либо дела на завтра?"

    a "Да вроде как нету, а что?"

    v 'Можем завтра пойти в галлерею "Мраморин". Ты не против?'

    a "Ух-ты, конечно не против! Во сколько пойдем?"

    v "Отлично! Я сегодня напишу тебе время. До встречи!"

    a "Хорошо, увидимся!"
    hide vera normal
    with dissolve
    "Вера пошла с книгой на кассу, видимо решила взять ее с собой."

    a "Мне тоже пора идти, нужно положить книгу обратно и домой пойти."

    hide artem normal
    with dissolve
    show priz at right2
    with dissolve
    pr "Проснитесь №367."
    stop music
    jump room
    return

label library_ne_pomog: 
    $ error += 1
    play sound ru
    show bg library polki
    with fade
    show artem normal at left2
    with dissolve
    a "Ладно, сейчас книгу на место положу и подойду."

    show zzz at right2
    a "..."
    
    a "Что?"
    hide zzz
    a "Опять?"
    show vera normal at right2
    v "О, Артем! Привет. Можешь помочь пожалуйста?"

    a "Ой"
    
    a "Привет! Хорошо, давай помогу. Эту книгу?"

    v "Да эту книгу, спасибо."

    a "Что читаешь тут?"

    v "Я готовлюсь к новому проекту, и хочу подсмотреть что-то интересное."

    a "Это звучит отлично. А насчет предыдущего проекта? Уже доделала?"

    v "Еще нет, но почти закончила. Как закончу, тебе первому покажу!"

    a @ blush "Ой, спасибо за такую честь"

    v "А что ты тут читаешь?"

    a "Да меня художество заинтересовало немного. Вот и решил почитать."

    v "Слушай, а у тебя есть какие-либо дела на завтра?"

    a "Да вроде как нету, а что?"

    v 'Можем завтра пойти в галлерею "Мраморин". Ты не против?'

    a "Ух-ты, конечно не против! Во сколько пойдем?"

    v "Отлично! Я сегодня напишу тебе время. До встречи!"

    a "Хорошо, увидимся!"
    hide vera normal
    with dissolve
    "Вера пошла с книгой на кассу, видимо решила взять ее с собой."

    a "Мне тоже пора идти, нужно положить книгу обратно и домой пойти."

    a "Странно. Что я увидел в начале? Влада?"

    a "Видимо устал уже, нужно уже пойти домой"
    stop music 
    jump room

    return

label room:
    stop music
    hide priz 
    with dissolve
    show bg room
    with fade
    show artem normal at left2
    with dissolve
    a "Вот я и дома. Нужно поесть, умыться и лечь спать."
   
    "Дзынь."

    a "О, а вот и Вера написала. Сказала, что к 6 нужно будет подойти. Надеюсь не опоздаю."
    hide artem normal
    with dissolve
    jump gallery
    return

label gallery:

    show bg street
    with fade
    "Артем опаздывает на встречу."
    show vera normal at right2
    with dissolve

    v "Что-то он опаздывает."

    show artem normal at left2
    with dissolve
    a "Привет, прости, что опаздал. Задержался на парах."
    play music mus1
    v "Ничего страшного!"

    a "Ну что, пойдем?"

    v "Давай."
    show bg gallery1
    with fade
    "Вера с Артемом зашли в галерею и подошли к кассе."

    "Билет стоит 350 рублей."

    menu:
        "Как оплатить билет?"
        "Только за себя.":
            jump ne_oplatil
        "За обоих.":
            jump oplatil
    return

label oplatil:
    play sound ru
    a "Давай я оплачу."

    v "Ой, спасибо!"

    jump gallery2
    return

label ne_oplatil:
    $ error += 1
    play sound ru
    "Они зашли в холл, подошли на кассу. Оплатили каждый себе билет. и зашли в саму галерею."
    jump gallery2
    return

label gallery2:

    "Холл галереи оказался просторным и светлым, наполненным атмосферой творчества."
   
    "Вера с Артемом вошли вместе, разглядывая прекрасные произведения искусства, которые великолепно декорировали стены. В глаза бросалось разнообразие стилей, словно каждая картина рассказывала свою уникальную историю."
   
    a "Какое красивое место. Тут так много различных картин."

    v 'Ага, вот, посмотри на эту картину. Это "Утро в городе" от талантливого художника Никиты Попова написана в 1789 году. Он всегда удивляет своим мастерством передачи света и тени.'

    a "Да, он действительно создает ощущение утра, когда город только просыпается."

    "Они продолжили ходить по галерее."

    v 'Это «Внутренний мир» написана Натальей Смирновой в 1990 году. Она специализируется на портретах и всегда стремится передать внутренний мир своих моделей.'

    a "Это просто потрясающе, как она передает эмоции через свои картины."

    v "У тебя хорошо получается рассматривать душу картины."

    a "Мне в детстве нравилось рисовать."

    v "А рисунки остались? Может поглядим на них вместе."

    a "Даже уже не помню. Поищу дома."

    v "Хорошо."

    show bg gallery2
    with fade
    show vera normal at right2
    with dissolve
    show artem normal at left2
    with dissolve

    v "Это зал посвящен великой художнице Наталии Петровой."

    v 'Взгляни на эту серию ее портретов "Лики Души". Она умело передает эмоции и индивидуальность каждого человека, запечатленного на холсте.'

    a "Прекрасные картины. Может быть когда-то среди них будут и твои."

    v "Ой, спасибо."

    v 'А это «Сельская Идиллия». Написана Наталией в 1788 году. Посвящена обычным сельским крестьянинам.'

    a "Я как будто нахожусь в этой сельской местности прямо сейчас."

    v 'А это картина "Серое пятно". Ее написала Наталия в 1832 году. Это последняя ее картина. Через год после ее написания к сожалению она ушла на тот свет.'

    a "Этот мир утратил такой талант."

    v "Ага. Мне нравятся ее картины, но в следуйщем зале мои любимые."
    hide artem normal
    hide vera normal
    show bg gallery3
    with fade

    v "А это мои любимые картины. Про какую хочешь услышать первым?"
    menu:
        "Про какую картину Вера расскажет?"
        "Картина с абстрактной композицией.":
            jump art1
        "Картина с пейзажем городской улицы.":
            jump art2
        "Картина с природой.":
            jump art3
    return

label art1:
    show bg art1
    with fade
    a "Давай рассмотрим картину с абстрактной композицией."
    
    v 'Это "Хаос и Гармония" Написана в 1979 году Марией Ивановой. Полотно переплетает яркие краски и различные фигуры, создавая впечатление беспорядка, который совершенно гармоничен и сбалансирован в своей сложности.'
    v "Каждая краска и линия кажется самобытной, но вместе они образуют удивительное целое, приглашая зрителя проникнуться красотой и разнообразием абстрактного мира." 
